# -- Supabase - PRODUCTION (REQUIRED: the app has no other data source) --
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: no service-role key is needed. Backups are manual only and run as the
# signed-in admin, so nothing in this app ever bypasses RLS.

# ── Supabase — DEMO (a SEPARATE project, fully isolated from production) ──
# Optional. When set, a "Coba Mode Demo" button appears on the login page and
# demo mode talks ONLY to this project. See README → "Mode Demo".
NEXT_PUBLIC_SUPABASE_DEMO_URL=
NEXT_PUBLIC_SUPABASE_DEMO_ANON_KEY=

# -- Violet (chatbot RAG) --
# Optional. With NEITHER key set, the Violet button simply does not appear.
#
# DELIBERATELY NOT PREFIXED "NEXT_PUBLIC_": these keys must stay on the server.
# Anything with that prefix is inlined into the JavaScript bundle and readable
# by every visitor, and this repository is public.

# Primary provider. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override; defaults to a current flash model.
GEMINI_MODEL=

# Backup provider, used automatically when Gemini's free quota runs out for the
# day (which it does, regularly). Without it, an exhausted quota means Violet is
# down until the counter resets. Get one from https://console.groq.com/keys
GROQ_API_KEY=
# Optional override; defaults to a current general-purpose instruct model.
GROQ_MODEL=
