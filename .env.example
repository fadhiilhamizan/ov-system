# ── Supabase — PRODUCTION (leave EMPTY to run in local demo mode) ──
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. BYPASSES RLS ENTIRELY — never expose it to the client and
# never import it outside src/lib/supabase/admin.ts.
# Required by the scheduled backup (/api/cron/backup): a cron request carries no
# cookies, so the normal per-user client reads zero rows and the backup silently
# captures nothing. Leave empty if you don't use scheduled backups.
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase — DEMO (a SEPARATE project, fully isolated from production) ──
# Optional. When set, a "Coba Mode Demo" button appears on the login page and
# demo mode talks ONLY to this project. See README → "Mode Demo".
NEXT_PUBLIC_SUPABASE_DEMO_URL=
NEXT_PUBLIC_SUPABASE_DEMO_ANON_KEY=

# ── Cron backup (optional) ──
CRON_SECRET=
